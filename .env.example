# OpenAI-compatible API base URL, ending in /v1, or the complete endpoint URL.
COURTYARD_API_URL=
COURTYARD_API_KEY=
COURTYARD_MODEL=gpt-5.6-sol
# responses (default) or chat (Chat Completions, including local Ollama)
# COURTYARD_API_STYLE=chat
# Optional deployment path, such as /golden-courtyard/
# COURTYARD_BASE_PATH=/golden-courtyard/
# Local-only opt-in for copyrighted game portraits kept outside the public repository.
# VITE_COURTYARD_LOCAL_PORTRAITS=true
